# Include this file inside Nginx's http context (for example, in conf.d).
# Replace 192.168.1.50 with the private LAN address of the RAG/Admin device.
upstream rag_api {
    server 192.168.1.50:8000;
}

upstream admin_api {
    server 192.168.1.50:8003;
}

server {
    listen 80;
    server_name _;
    root /var/www/aiok-ui;
    index index.html;

    location = /api/stt {
        client_max_body_size 6m;
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /api/tts {
        proxy_pass http://127.0.0.1:8002;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/admin/ {
        client_max_body_size 26m;
        proxy_pass http://admin_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
    }

    location = /api/admin {
        proxy_pass http://admin_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/ {
        proxy_pass http://rag_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}